//interesting concept - By the end of the loop, end will be in the left of start if target is not found

//1 3  8 10 15   target 12
//       e   s

//toh hum end and start se target ko subtract krke dekhenge, jo close hua usko return kr denge

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner scanner = new Scanner(System.in);
        int n = scanner.nextInt();
        int k = scanner.nextInt();
        int[] arr = new int[n];
        int ans =-1;
        
        for (int i = 0; i < n; i++) {
            arr[i] = scanner.nextInt();
        }
        scanner.close();
		int start = 0;
        int end = n - 1;
        

        while (start <= end) {
            int mid = start + (end - start) / 2;

            if (arr[mid] == k) {
                ans = arr[mid];
            }
            else if(arr[mid] < k){
                start = mid+1;
            }
            else {
                end = mid - 1;
            }
        }
      
        int result = (Math.abs(arr[start] - k) < Math.abs(arr[end] - k)) ? arr[start] : arr[end];
        if(ans != -1) {
            result = ans;
        }
       

        System.out.println(result);
    

	}
}
